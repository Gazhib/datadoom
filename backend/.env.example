# Copy to backend/.env and run with --env-file backend/.env from the repository root.
EVALUATOR_URL=http://127.0.0.1:8001
UPSTREAM_TIMEOUT_SECONDS=60
BACKEND_ALLOW_FIXTURE=false

# Optional. Keep the complete signed URL only in the ignored backend/.env file.
# ORGANIZER_GET_URL=

# Defaults are absolute paths derived from the backend directory.
# DATABASE_PATH=backend/storage/datadoom.sqlite3
# FRONTEND_DIST=frontend/dist
