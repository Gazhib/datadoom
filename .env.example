# Optional Compose settings. Add the settings you need to the ignored root .env.
# DATADOOM_PORT=8000
# DATADOOM_FRONTEND_PORT=5173
# ORGANIZER_GET_URL='https://example.invalid/signed-url'
# UPSTREAM_TIMEOUT_SECONDS=60
# EVALUATOR_STREAM=true

# Judge panel. ai/judges.yaml defines three local Ollama judges:
# judge-1 qwen3:8b, judge-2 gemma3:4b and judge-3 llama3.2:3b.
# Override any judge here without editing the YAML. Set the model whenever you change the provider.
# JUDGES_QUORUM=2
# JUDGES_TIMEOUT_SECONDS=55
# JUDGE_1_PROVIDER=ollama
# JUDGE_1_MODEL=qwen3:8b
# JUDGE_1_URL=
# JUDGE_1_API_KEY_ENV=
# JUDGE_1_TEMPERATURE=
# JUDGE_2_PROVIDER=openai
# JUDGE_2_MODEL=gpt-5.4-mini
# JUDGE_3_PROVIDER=gemini
# JUDGE_3_MODEL=gemini-3.1-flash-lite

# Provider-wide settings used when a judge leaves url, model or api_key_env unset.
# LLAMA_CPP_URL=http://host.docker.internal:8080
# LLAMA_CPP_MODEL=Qwen3-1.7B-Q4_K_M
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:1.7b
# OPENAI_API_KEY=
# OPENAI_MODEL=
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
